# Copy to .env.local for local development. Never commit real values.

# Neon pooled connection string (Dashboard > Connect > Pooled connection)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Auth (used from M1). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Protects /api/cron/recalc. Vercel sends it automatically when set in project env.
CRON_SECRET=change-me

# Device polls answered from memory for this many minutes between database visits, so a
# database that sleeps when idle (Neon free plan) can sleep. 20 if unset. Set 0 on a server
# whose database never sleeps, like the VPS: commands then reach the device within 30 seconds.
# ADMS_QUIET_MINUTES=20

# Office time zone for all attendance dates
APP_TIMEZONE=Asia/Dhaka

# First owner login, used only by `npm run seed:owner`. Remove the password after seeding.
# OWNER_EMAIL=you@example.com
# OWNER_NAME=Your Name
# OWNER_PASSWORD=
