# Copy to .env.local for local development. Never commit real values.

# Neon pooled connection string (Dashboard > Connect > Pooled connection)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Auth (used from M1). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Protects /api/cron/recalc. Vercel sends it automatically when set in project env.
CRON_SECRET=change-me

# Office time zone for all attendance dates
APP_TIMEZONE=Asia/Dhaka
